FISHBOWL_BASE_URL=http://100.x.x.x:2456
FISHBOWL_USERNAME=
FISHBOWL_PASSWORD=
FISHBOWL_APP_NAME=ColdBlockDashboard
FISHBOWL_APP_ID=1
FISHBOWL_APP_DESCRIPTION=ColdBlock Intelligence Dashboard
FISHBOWL_APP_KEY=coldblock-dashboard-key

HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_API_TOKEN=

# Microsoft Planner via Graph, app-only auth. Needs an Azure AD app registration
# with APPLICATION permissions Tasks.Read.All + User.Read.All and tenant admin
# consent (an admin has to grant it — a regular user can't). Tasks are read per
# person across every plan, so there are no plan IDs to list. Client secrets
# expire on a fixed date: note it, and rotate before then — an expired secret
# shows up on the Tasks page as a Planner notice while HubSpot keeps working.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
ENABLE_PLANNER=false

DASHBOARD_USERS=[{"username":"jorge","password":"changeme"},{"username":"coworker","password":"changeme2"}]
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Fishbowl is only reachable over the office Tailscale tailnet. Set to true only
# where that tailnet is reachable (e.g. local dev); leave false on public hosts.
ENABLE_FISHBOWL=false

USE_MOCK_DATA=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
